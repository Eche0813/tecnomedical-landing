---
/**
 * @fileoverview Layout principal de la aplicación TECNOMEDICALS S.A.S.
 * Define la estructura HTML base, metas SEO, fuentes globales, header adaptativo y footer.
 */

import '../styles/global.css';

/**
 * Propiedades aceptadas por el layout para personalizar el SEO por página.
 */
interface Props {
  /** Título de la página que se mostrará en la pestaña del navegador y tags Open Graph */
  title?: string;
  /** Meta descripción para posicionamiento en motores de búsqueda */
  description?: string;
  /** Imagen previa al compartir el enlace en redes sociales */
  image?: string;
}

const {
  title = "TECNOMEDICALS S.A.S. | Equipos de Oxigenoterapia y Salud en Casa",
  description = "Acompañamiento, venta y alquiler de concentradores de oxígeno, CPAP y tecnología médica para el cuidado de tu familia con envío a toda Colombia.",
  image = "/og-image.jpg"
} = Astro.props;

// URL canónica para evitar contenido duplicado en motores de búsqueda
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://tecnomedical.com');
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  
  <body class="bg-slate-50 text-[#1A1A1A] font-sans antialiased selection:bg-[#0082C3] selection:text-white flex flex-col min-h-screen">
    
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <a href="/" class="flex items-center gap-2.5 sm:gap-3 group no-underline shrink-0">
              <img 
                src="/Logo.jpeg" 
                alt="Logo Tecnomedicals S.A.S." 
                class="h-9 sm:h-11 w-auto object-contain transition-transform group-hover:scale-105"
              />
              <div class="flex flex-col">
                <span class="text-base sm:text-xl font-black text-[#0082C3] tracking-tight leading-none">
                  TECNOMEDICALS <span class="text-[#003B73]">S.A.S.</span>
                </span>
              </div>
            </a>
            
            <nav class="hidden md:flex items-center gap-6 text-sm font-medium" aria-label="Navegación principal">
              <a href="/" class="text-slate-700 hover:text-[#0082C3] transition">Inicio</a>
              <a href="/catalogo" class="text-slate-700 hover:text-[#0082C3] transition font-semibold">Catálogo</a>
              <a href="/quienes-somos" class="text-slate-700 hover:text-[#0082C3] transition font-semibold">Quiénes Somos</a>
              <a 
                href="https://wa.me/573000000000?text=Hola%20Tecnomedical,%20quisiera%20asesor%C3%ADa" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-4 py-2 rounded-xl bg-[#0082C3] hover:bg-[#003B73] text-white font-semibold text-sm transition-all shadow-xs hover:shadow-md"
              >
                Contacto
              </a>
            </nav>

            <button 
              id="menu-toggle-btn"
              type="button" 
              class="md:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#0082C3]"
              aria-label="Abrir o cerrar menú de navegación"
              aria-expanded="false"
            >
              <svg id="menu-icon" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
        </div>

        <div id="mobile-dropdown" class="hidden md:hidden bg-white border-b border-slate-200 px-4 pt-2 pb-6 space-y-3 shadow-lg">
          <a href="/" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0082C3]">Inicio</a>
          <a href="/catalogo" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0082C3]">Catálogo</a>
          <a href="/quienes-somos" class="block px-3 py-2.5 rounded-xl text-base font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0082C3]">Quiénes Somos</a>
          <a 
            href="https://wa.me/573000000000?text=Hola%20Tecnomedical,%20quisiera%20asesor%C3%ADa" 
            target="_blank"
            rel="noopener noreferrer"
            class="block text-center w-full mt-2 px-4 py-3 rounded-xl bg-[#0082C3] text-white font-bold text-sm shadow-xs"
          >
            Contacto
          </a>
        </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="bg-[#003B73] text-slate-200 py-12 border-t-4 border-[#0082C3]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <div>
          <p class="text-white font-extrabold text-lg mb-2 tracking-tight">TECNOMEDICALS S.A.S.</p>
          <p class="text-sm text-slate-200 leading-relaxed">
            Especialistas en oxigenación portátil, oxigenoterapia y terapia del sueño. Desde 2020 acompañamos a nuestros pacientes y sus familias con soluciones respiratorias confiables.
          </p>
        </div>

        <div>
          <p class="text-white font-bold text-sm mb-3 border-b border-white/10 pb-1">Atención al Cliente</p>
          <p class="text-sm text-slate-200">Lunes a Viernes: 8:00 AM - 6:00 PM</p>
          <p class="text-sm text-slate-200 mt-1">Sábados: 8:00 AM - 1:00 PM</p>
        </div>

        <div>
          <p class="text-white font-bold text-sm mb-3 border-b border-white/10 pb-1">Contáctanos</p>
          <p class="text-sm text-slate-200">WhatsApp: +57 300 000 0000</p>
          <p class="text-sm text-slate-200 mt-1">Correo Electrónico: info@tecnomedical.com</p>
          <p class="text-sm text-slate-200 mt-1">Medellín, Colombia</p>
        </div>

        <div>
          <p class="text-white font-bold text-sm mb-3 border-b border-white/10 pb-1">Información Legal</p>
          <ul class="space-y-1.5 text-sm">
            <li><a href="#" class="hover:text-white transition-colors">Política de Tratamiento de Datos</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Términos y Condiciones</a></li>
            <li><a href="#" class="hover:text-white transition-colors">Políticas de Envío, Cambios y Garantías</a></li>
          </ul>
        </div>

      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10 pt-6 border-t border-white/10 text-xs text-center text-slate-300">
        &copy; {new Date().getFullYear()} TECNOMEDICALS S.A.S. Todos los derechos reservados.
      </div>
    </footer>

    <script>
      /**
       * Inicializa el listener para desplegar/contraer el menú móvil al hacer clic.
       */
      const menuBtn = document.getElementById('menu-toggle-btn');
      const mobileDropdown = document.getElementById('mobile-dropdown');

      menuBtn?.addEventListener('click', () => {
        const isHidden = mobileDropdown?.classList.toggle('hidden');
        menuBtn.setAttribute('aria-expanded', isHidden ? 'false' : 'true');
      });
    </script>

  </body>
</html>