---
import Layout from '../layouts/Layout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { getProducts } from '../services/getProducts.js';

const allProducts = await getProducts();

// Filtrado por categoría
const oxigenoterapiaProducts = allProducts.filter(
  p => p.category === "Oxigenoterapia Avanzada"
);

const suenoProducts = allProducts.filter(
  p => p.category === "Terapia del Sueño"
);
---

<Layout 
title="Catálogo de Equipos Médicos | TECNOMEDICALS S.A.S."
  description="Catálogo de oxigenoterapia avanzada y equipos de terapia del sueño CPAP/BiPAP con registro INVIMA en Colombia."
>
  <!-- Encabezado de la Página -->
  <section class="bg-gradient-to-b from-blue-900 via-slate-900 to-slate-900 text-white py-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-blue-500/20 text-blue-300 border border-blue-400/30 mb-4">
        Catálogo Especializado
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
        Equipos de Oxigenoterapia & Terapia del Sueño
      </h1>
      <p class="mt-4 text-slate-300 text-base sm:text-lg max-w-2xl mx-auto">
        Explora nuestros equipos homologados con garantía oficial y soporte técnico directo en Colombia.
      </p>

      <!-- Botones de Salto Rápido a Secciones -->
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a 
          href="#oxigenoterapia" 
          class="px-5 py-2.5 rounded-xl bg-blue-600/80 hover:bg-blue-600 text-white font-medium text-sm transition backdrop-blur-sm border border-blue-400/30 flex items-center gap-2"
        >
          <span>💨</span> Oxigenoterapia Avanzada
        </a>
        <a 
          href="#terapia-sueno" 
          class="px-5 py-2.5 rounded-xl bg-indigo-600/80 hover:bg-indigo-600 text-white font-medium text-sm transition backdrop-blur-sm border border-indigo-400/30 flex items-center gap-2"
        >
          <span>🌙</span> Terapia del Sueño (CPAP / BiPAP)
        </a>
      </div>
    </div>
  </section>

  <main class="bg-slate-50 py-12 space-y-16">
    
    <!-- SECCIÓN 1: Oxigenoterapia Avanzada -->
    <section id="oxigenoterapia" class="scroll-mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="flex items-center gap-3 border-b border-slate-200 pb-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-xl">
            💨
          </div>
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900">Oxigenoterapia Avanzada</h2>
            <p class="text-sm text-slate-600">Concentradores estacionarios, portátiles y accesorios respiratorios.</p>
          </div>
        </div>
      </div>
      <ProductGrid products={oxigenoterapiaProducts} />
    </section>

    <!-- SECCIÓN 2: Terapia del Sueño -->
    <section id="terapia-sueno" class="scroll-mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-6">
        <div class="flex items-center gap-3 border-b border-slate-200 pb-4">
          <div class="w-10 h-10 rounded-xl bg-indigo-600 text-white flex items-center justify-center font-bold text-xl">
            🌙
          </div>
          <div>
            <h2 class="text-2xl font-extrabold text-slate-900">Terapia del Sueño</h2>
            <p class="text-sm text-slate-600">Dispositivos CPAP, BiPAP y mascarillas anatómicas para apnea del sueño.</p>
          </div>
        </div>
      </div>
      <ProductGrid products={suenoProducts} />
    </section>

  </main>

  <WhatsappButton />
</Layout>