---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { getProducts } from '../services/getProducts.js';

// Obtenemos los productos reales (desde Google Sheets o Fallback)
const allProducts = await getProducts();

// Seleccionamos únicamente los primeros 3 productos disponibles para la portada
const featuredProducts = allProducts.filter(p => p.available).slice(0, 3);
---

<Layout title="TECNOMEDICALS S.A.S. | Equipos de Oxigenoterapia y Salud en Casa">
  <Hero />
  <HowItWorks />
  <TrustBadges />
  
  <!-- Sección de Equipos Destacados -->
  <section class="bg-slate-50 pt-8 pb-4">
    <ProductGrid 
      products={featuredProducts}
      showHeader={true} 
      title="Equipos Respiratorios Destacados"
      description="Conoce los equipos más solicitados para soporte respiratorio domiciliario con garantía y entrega a nivel nacional."
    />
  </section>
  
  <!-- Botón hacia el Catálogo Completo -->
  <div class="text-center pb-16 bg-slate-50">
    <a 
      href="/catalogo" 
      class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-[#0082C3] text-[#0082C3] hover:bg-[#0082C3] hover:text-white font-bold rounded-xl transition-all shadow-xs gap-2"
    >
      Ver Catálogo Completo &rarr;
    </a>
  </div>

  <WhatsappButton />
</Layout>