---
/**
 * @fileoverview Página de inicio principal (Landing Page) de TECNOMEDICALS S.A.S.
 * Muestra el Hero banner, flujo de trabajo, insignias de confianza, productos destacados en vivo y botón flotante de WhatsApp.
 */

// Desactiva el prerenderizado estático para forzar la consulta en vivo de productos vía SSR en cada petición
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProductGrid from '../components/ProductGrid.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { getProducts } from '../services/getProducts.js';
import { SITE_CONFIG } from '../config/site';

/**
 * Carga el catálogo completo desde Google Sheets mediante el servicio getProducts.
 */
const allProducts = await getProducts();

/**
 * Filtra los primeros 3 productos en stock para presentar como destacados en la portada.
 */
const featuredProducts = allProducts.filter(p => p.available).slice(0, 3);
---

<Layout title={`${SITE_CONFIG.name} | Equipos de Oxigenoterapia y Salud en Casa`}>
  <!-- Banner Principal e Introducción -->
  <Hero />

  <!-- Pasos para Alquiler/Compra y Beneficios -->
  <HowItWorks />

  <!-- Insignias de Garantía y Confianza -->
  <TrustBadges />
  
  <!-- Showcase de Equipos Respiratorios Destacados -->
  <section class="bg-slate-50 pt-8 pb-4" aria-label="Productos destacados">
    <ProductGrid 
      products={featuredProducts}
      showHeader={true} 
      title="Equipos Respiratorios Destacados"
      description="Conoce los equipos más solicitados para soporte respiratorio domiciliario con garantía y entrega a nivel nacional."
    />
  </section>
  
  <!-- Llamado a la Acción hacia el Catálogo General -->
  <div class="text-center pb-16 bg-slate-50">
    <a 
      href="/catalogo" 
      class="inline-flex items-center justify-center px-6 py-3.5 border-2 border-[#0082C3] text-[#0082C3] hover:bg-[#0082C3] hover:text-white font-bold rounded-xl transition-all shadow-xs gap-2"
    >
      Ver Catálogo Completo &rarr;
    </a>
  </div>

  <!-- Botón de Acción Directa a WhatsApp -->
  <WhatsappButton />
</Layout>