---
/**
 * @fileoverview Tarjeta de producto con micro-carrusel interactivo corregido.
 */

import { SITE_CONFIG } from '../config/site';

interface Props {
  id: string | number;
  title: string;
  price: number;
  image: string;
  images?: string[];
  available: boolean;
  category?: string;
}

const { id, title, price, image, images = [], available, category = "Oxigenoterapia" } = Astro.props;

const productImages = images.length > 0 ? images : [image];
const hasMultipleImages = productImages.length > 1;

const formattedPrice = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0
}).format(price);

const message = encodeURIComponent(`Hola Tecnomedical, estoy interesado en recibir información sobre el equipo: ${title}.`);
const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${message}`;
---

<article 
  class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:border-[#0082C3]/50 hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col justify-between group product-card" 
  data-product-card
>
  
  <div class="p-5">
    <!-- Categoría & Stock -->
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[#0082C3]/10 text-[#0082C3] border border-[#0082C3]/20">
        {category}
      </span>
      {available ? (
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          Disponible
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
          Agotado
        </span>
      )}
    </div>

    <!-- Contenedor del Micro-Carrusel -->
    <div class="relative w-full h-48 bg-slate-50 rounded-xl mb-4 overflow-hidden flex items-center justify-center p-4 group/carousel">
      
      <!-- Contenedor de Galería de Imágenes -->
      <div class="w-full h-full relative flex items-center justify-center">
        {productImages.map((imgUrl, index) => (
          <img
            src={imgUrl}
            alt={`Vista ${index + 1} de ${title}`}
            class={`carousel-img absolute inset-0 w-full h-full object-contain pointer-events-none transition-opacity duration-300 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
            loading="lazy"
            referrerpolicy="no-referrer"
            data-index={index}
            width="300"
            height="300"
          />
        ))}
      </div>

      <!-- Controles Manuales (Solo si hay más de 1 imagen) -->
      {hasMultipleImages && (
        <>
          <!-- Botón Izquierda -->
          <button
            type="button"
            class="btn-prev absolute left-2 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-white text-slate-800 p-2 rounded-full shadow-md transition-all opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            aria-label="Imagen anterior"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/>
            </svg>
          </button>

          <!-- Botón Derecha -->
          <button
            type="button"
            class="btn-next absolute right-2 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-white text-slate-800 p-2 rounded-full shadow-md transition-all opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            aria-label="Siguiente imagen"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
            </svg>
          </button>

          <!-- Indicadores de Puntos (Dots) -->
          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-30 flex gap-1.5 bg-black/40 backdrop-blur-xs px-2.5 py-1 rounded-full pointer-events-none">
            {productImages.map((_, idx) => (
              <span class={`carousel-dot w-1.5 h-1.5 rounded-full transition-all ${idx === 0 ? 'bg-white w-3' : 'bg-white/50'}`}></span>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- Título y Precio -->
    <h3 class="text-lg font-bold text-[#003B73] line-clamp-2 min-h-[3.5rem] leading-snug">
      {title}
    </h3>
    
    <div class="mt-2">
      <p class="text-2xl font-extrabold text-[#0082C3] tracking-tight">
        {formattedPrice}
      </p>
    </div>
  </div>

  <!-- Botón WhatsApp -->
  <div class="p-5 pt-0">
    {available ? (
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Consultar disponibilidad de ${title} por WhatsApp`}
        class="w-full inline-flex items-center justify-center gap-2 bg-[#0082C3] hover:bg-[#003B73] text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 shadow-xs hover:shadow-md"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        Consultar por WhatsApp
      </a>
    ) : (
      <button type="button" disabled class="w-full bg-slate-100 text-slate-400 font-medium py-3 px-4 rounded-xl cursor-not-allowed text-center">
        Temporalmente Sin Stock
      </button>
    )}
  </div>
</article>

<script>
  /**
   * Manejador de navegación para todos los micro-carruseles de la página.
   */
  function initProductCarousels() {
    const cards = document.querySelectorAll('[data-product-card]');

    cards.forEach((card) => {
      const images = card.querySelectorAll('.carousel-img');
      const btnPrev = card.querySelector('.btn-prev');
      const btnNext = card.querySelector('.btn-next');
      const dots = card.querySelectorAll('.carousel-dot');

      if (images.length <= 1) return;

      let currentIndex = 0;

      const setSlide = (newIndex) => {
        // Quitar estado activo actual
        images[currentIndex].classList.remove('opacity-100', 'z-10');
        images[currentIndex].classList.add('opacity-0', 'z-0');

        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('bg-white', 'w-3');
          dots[currentIndex].classList.add('bg-white/50');
        }

        // Calcular nuevo índice circular
        currentIndex = (newIndex + images.length) % images.length;

        // Asignar nuevo estado activo
        images[currentIndex].classList.remove('opacity-0', 'z-0');
        images[currentIndex].classList.add('opacity-100', 'z-10');

        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('bg-white/50');
          dots[currentIndex].classList.add('bg-white', 'w-3');
        }
      };

      btnPrev?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        setSlide(currentIndex - 1);
      });

      btnNext?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        setSlide(currentIndex + 1);
      });
    });
  }

  // Ejecuta la inicialización al cargar la página
  initProductCarousels();
</script>