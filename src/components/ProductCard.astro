---
/**
 * @fileoverview Tarjeta de producto cliqueable para TECNOMEDICALS S.A.S.
 * Permite abrir un modal desplegable con la galería completa de imágenes,
 * ficha técnica convertida a viñetas desde texto plano y botón directo a WhatsApp.
 * 
 * @module components/ProductCard
 */

import { SITE_CONFIG } from '../config/site';

/**
 * Propiedades aceptadas por el componente ProductCard.
 */
interface Props {
  /** Identificador único del producto */
  id: string | number;
  /** Nombre comercial del equipo */
  title: string;
  /** Descripción o ficha técnica extensa en texto plano */
  description?: string;
  /** Precio en Pesos Colombianos (COP) */
  price: number;
  /** URL de la imagen principal */
  image: string;
  /** Arreglo opcional con todas las URLs de imágenes */
  images?: string[];
  /** Estado de disponibilidad e inventario */
  available: boolean;
  /** Categoría comercial del producto */
  category?: string;
}

const { 
  id, 
  title, 
  description = '', 
  price, 
  image, 
  images = [], 
  available, 
  category = "Oxigenoterapia" 
} = Astro.props;

const productImages: string[] = images.length > 0 ? images : [image];
const hasMultipleImages: boolean = productImages.length > 1;

const formattedPrice: string = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0
}).format(price);

const message: string = encodeURIComponent(`Hola Tecnomedical, estoy interesado en recibir información sobre el equipo: ${title}.`);
const whatsappUrl: string = `https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${message}`;

/**
 * Convierte el texto plano con guiones (-) proveniente de Google Sheets
 * en párrafos y listas con viñetas HTML estilizadas.
 */
function formatDescription(rawText: string = ''): string {
  if (!rawText) {
    return '<p class="text-slate-500 italic">No hay especificaciones adicionales para este producto.</p>';
  }

  const lines = rawText.split('\n').map(line => line.trim()).filter(Boolean);
  let html = '';
  let inList = false;

  lines.forEach(line => {
    if (line.startsWith('-') || line.startsWith('*') || line.startsWith('•')) {
      if (!inList) {
        html += '<ul class="list-disc pl-5 space-y-1.5 my-3 text-slate-600 font-normal">';
        inList = true;
      }
      const itemText = line.replace(/^[-*•]\s*/, '');
      html += `<li>${itemText}</li>`;
    } else {
      if (inList) {
        html += '</ul>';
        inList = false;
      }
      html += `<p class="mb-2 text-slate-700 font-normal leading-relaxed">${line}</p>`;
    }
  });

  if (inList) html += '</ul>';

  return html;
}

const formattedDescriptionHtml: string = formatDescription(description);
---

<article 
  class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:border-[#0082C3]/50 hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col justify-between group relative product-card" 
  data-product-card
>
  
  <!-- Cuerpo Clickeable para desplegar el Modal -->
  <div class="p-5 cursor-pointer btn-open-modal">
    <!-- Categoría & Estado de Stock -->
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[#0082C3]/10 text-[#0082C3] border border-[#0082C3]/20">
        {category}
      </span>
      {available ? (
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          Disponible
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
          Agotado
        </span>
      )}
    </div>

    <!-- Contenedor del Micro-Carrusel en la Tarjeta -->
    <div class="relative w-full h-48 bg-slate-50 rounded-xl mb-4 overflow-hidden flex items-center justify-center p-4 group/carousel">
      <div class="w-full h-full relative flex items-center justify-center">
        {productImages.map((imgUrl, index) => (
          <img
            src={imgUrl}
            alt={`Vista ${index + 1} de ${title}`}
            class={`carousel-img absolute inset-0 w-full h-full object-contain pointer-events-none transition-opacity duration-300 ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'}`}
            loading="lazy"
            referrerpolicy="no-referrer"
            data-index={index}
            width="300"
            height="300"
          />
        ))}
      </div>

      {hasMultipleImages && (
        <>
          <button
            type="button"
            class="btn-prev absolute left-2 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-white text-slate-800 p-2 rounded-full shadow-md transition-all opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            aria-label="Imagen anterior"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>

          <button
            type="button"
            class="btn-next absolute right-2 top-1/2 -translate-y-1/2 z-30 bg-white/90 hover:bg-white text-slate-800 p-2 rounded-full shadow-md transition-all opacity-0 group-hover/carousel:opacity-100 cursor-pointer active:scale-95"
            aria-label="Siguiente imagen"
          >
            <svg class="w-4 h-4 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>

          <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-30 flex gap-1.5 bg-black/40 backdrop-blur-xs px-2.5 py-1 rounded-full pointer-events-none">
            {productImages.map((_, idx) => (
              <span class={`carousel-dot w-1.5 h-1.5 rounded-full transition-all ${idx === 0 ? 'bg-white w-3' : 'bg-white/50'}`}></span>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- Título e Indicador Interactivo -->
    <h3 class="text-lg font-bold text-[#003B73] line-clamp-1 leading-snug group-hover:text-[#0082C3] transition-colors">
      {title}
    </h3>

    <p class="mt-1 text-xs text-slate-400 font-medium flex items-center gap-1 group-hover:text-[#0082C3] transition-colors">
      Clic para ver especificaciones completas
      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
    </p>
    
    <div class="mt-3">
      <p class="text-2xl font-extrabold text-[#0082C3] tracking-tight">
        {formattedPrice}
      </p>
    </div>
  </div>

  <!-- Botón WhatsApp Directo (Aislado) -->
  <div class="p-5 pt-0 z-20 relative">
    {available ? (
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Consultar disponibilidad de ${title} por WhatsApp`}
        class="btn-whatsapp w-full inline-flex items-center justify-center gap-2 bg-[#0082C3] hover:bg-[#003B73] text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 shadow-xs hover:shadow-md cursor-pointer"
      >
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="#FFFFFF" d="M12.011 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.762.459 3.48 1.33 4.998l-1.413 5.163 5.282-1.387c1.465.799 3.118 1.22 4.79 1.22h.004c5.503 0 9.986-4.478 9.986-9.984 0-2.668-1.037-5.176-2.922-7.062a9.923 9.923 0 0 0-7.068-2.932z"/>
          <path class="text-[#0082C3]" fill="currentColor" d="M12.031 6.172c-3.181 0-5.767 2.586-5.767 5.767 0 1.267.408 2.44 1.101 3.396l-.723 2.641 2.703-.709a5.726 5.726 0 002.686.672h.003c3.181 0 5.767-2.586 5.767-5.767 0-3.181-2.586-5.767-5.767-5.767zm3.364 8.167c-.141.397-.822.759-1.15.808-.295.044-.667.062-1.077-.068-.248-.079-.566-.184-.915-.338-1.606-.708-2.643-2.333-2.723-2.44-.08-.107-.613-.817-.613-1.558 0-.741.385-1.106.522-1.256.137-.15.298-.188.398-.188.1 0 .201.001.289.006.094.005.221-.036.345.262.128.307.437 1.066.475 1.143.038.077.064.167.013.269-.051.102-.077.167-.154.256-.077.09-.162.201-.231.272-.077.077-.157.161-.067.315.09.154.399.658.857 1.066.589.524 1.084.687 1.238.763.154.077.244.064.334-.038.09-.102.385-.448.488-.601.103-.154.205-.128.346-.077.141.051.898.423 1.052.5.154.077.256.115.294.18.038.064.038.372-.103.769z"/>
        </svg>
        Consultar por WhatsApp
      </a>
    ) : (
      <button type="button" disabled class="w-full bg-slate-100 text-slate-400 font-medium py-3 px-4 rounded-xl cursor-not-allowed text-center">
        Temporalmente Sin Stock
      </button>
    )}
  </div>

  <!-- MODAL DESPLEGABLE CON GALERÍA DE IMÁGENES COMPLETA -->
  <dialog class="modal-dialog fixed inset-0 z-50 bg-black/60 backdrop-blur-xs p-4 w-full h-full max-w-none max-h-none border-0 hidden items-center justify-center">
    <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] overflow-y-auto p-6 sm:p-8 shadow-2xl relative flex flex-col gap-6">
      
      <!-- Cierre -->
      <button type="button" class="btn-close-modal absolute top-4 right-4 text-slate-400 hover:text-slate-700 p-2 rounded-full hover:bg-slate-100 cursor-pointer transition-colors" aria-label="Cerrar ventana">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>

      <!-- Encabezado del Modal -->
      <div>
        <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[#0082C3]/10 text-[#0082C3] border border-[#0082C3]/20">
          {category}
        </span>
        <h2 class="text-2xl font-bold text-[#003B73] mt-2">{title}</h2>
        <p class="text-xl font-extrabold text-[#0082C3] mt-1">{formattedPrice}</p>
      </div>

      <!-- VISOR PRINCIPAL DE IMAGEN EN EL MODAL -->
      <div class="space-y-3">
        <div class="w-full h-64 sm:h-72 bg-slate-50 rounded-2xl overflow-hidden flex items-center justify-center p-4 border border-slate-100">
          <img 
            id={`modal-main-img-${id}`}
            src={productImages[0]} 
            alt={`Fotografía destacada de ${title}`} 
            class="max-h-full max-w-full object-contain transition-all duration-300" 
            referrerpolicy="no-referrer" 
          />
        </div>

        <!-- Mosaico/Miniaturas de selección de imagen (Solo si hay más de 1) -->
        {hasMultipleImages && (
          <div class="flex items-center gap-2 overflow-x-auto pb-1">
            {productImages.map((imgUrl, idx) => (
              <button
                type="button"
                class={`modal-thumb-${id} w-16 h-16 rounded-xl border-2 overflow-hidden flex-shrink-0 bg-slate-50 p-1 cursor-pointer transition-all ${idx === 0 ? 'border-[#0082C3] ring-2 ring-[#0082C3]/20' : 'border-slate-200 opacity-60 hover:opacity-100'}`}
                data-img-src={imgUrl}
                aria-label={`Ver foto ${idx + 1}`}
              >
                <img src={imgUrl} alt="" class="w-full h-full object-contain" referrerpolicy="no-referrer" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Especificaciones y Ficha Técnica -->
      <div class="border-t border-slate-100 pt-4">
        <h4 class="text-sm font-bold text-[#003B73] uppercase tracking-wider mb-3">Especificaciones y Descripción</h4>
        <div class="text-sm">
          <Fragment set:html={formattedDescriptionHtml} />
        </div>
      </div>

      <!-- Botón de Consulta WhatsApp dentro del Modal -->
      <div class="pt-4 border-t border-slate-100">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 bg-[#0082C3] hover:bg-[#003B73] text-white font-semibold py-3.5 px-4 rounded-xl transition-all duration-200 shadow-md"
        >
          <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#FFFFFF" d="M12.011 2c-5.506 0-9.989 4.478-9.989 9.984 0 1.762.459 3.48 1.33 4.998l-1.413 5.163 5.282-1.387c1.465.799 3.118 1.22 4.79 1.22h.004c5.503 0 9.986-4.478 9.986-9.984 0-2.668-1.037-5.176-2.922-7.062a9.923 9.923 0 0 0-7.068-2.932z"/>
            <path class="text-[#0082C3]" fill="currentColor" d="M12.031 6.172c-3.181 0-5.767 2.586-5.767 5.767 0 1.267.408 2.44 1.101 3.396l-.723 2.641 2.703-.709a5.726 5.726 0 002.686.672h.003c3.181 0 5.767-2.586 5.767-5.767 0-3.181-2.586-5.767-5.767-5.767zm3.364 8.167c-.141.397-.822.759-1.15.808-.295.044-.667.062-1.077-.068-.248-.079-.566-.184-.915-.338-1.606-.708-2.643-2.333-2.723-2.44-.08-.107-.613-.817-.613-1.558 0-.741.385-1.106.522-1.256.137-.15.298-.188.398-.188.1 0 .201.001.289.006.094.005.221-.036.345.262.128.307.437 1.066.475 1.143.038.077.064.167.013.269-.051.102-.077.167-.154.256-.077.09-.162.201-.231.272-.077.077-.157.161-.067.315.09.154.399.658.857 1.066.589.524 1.084.687 1.238.763.154.077.244.064.334-.038.09-.102.385-.448.488-.601.103-.154.205-.128.346-.077.141.051.898.423 1.052.5.154.077.256.115.294.18.038.064.038.372-.103.769z"/>
          </svg>
          Consultar este equipo por WhatsApp
        </a>
      </div>

    </div>
  </dialog>

</article>

<script id={`modal-script-${id}`}>
  (() => {
    const card = document.querySelector(`[data-product-card]`);
    // Cambio interactivo de miniaturas en el modal
    const mainImg = document.getElementById(`modal-main-img-${id}`);
    const thumbs = document.querySelectorAll(`.modal-thumb-${id}`);

    thumbs.forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const newSrc = thumb.getAttribute('data-img-src');
        if (mainImg && newSrc) {
          mainImg.setAttribute('src', newSrc);
        }

        thumbs.forEach(t => {
          t.classList.remove('border-[#0082C3]', 'ring-2', 'ring-[#0082C3]/20');
          t.classList.add('border-slate-200', 'opacity-60');
        });

        thumb.classList.remove('border-slate-200', 'opacity-60');
        thumb.classList.add('border-[#0082C3]', 'ring-2', 'ring-[#0082C3]/20');
      });
    });
  })();
</script>

<script>
  function initProductCarouselsAndModals() {
    const cards = document.querySelectorAll('[data-product-card]');

    cards.forEach((card) => {
      // Micro-carrusel de la tarjeta
      const images = card.querySelectorAll('.carousel-img');
      const btnPrev = card.querySelector('.btn-prev');
      const btnNext = card.querySelector('.btn-next');
      const dots = card.querySelectorAll('.carousel-dot');

      if (images.length > 1) {
        let currentIndex = 0;

        const setSlide = (newIndex) => {
          images[currentIndex].classList.remove('opacity-100', 'z-10');
          images[currentIndex].classList.add('opacity-0', 'z-0');

          if (dots[currentIndex]) {
            dots[currentIndex].classList.remove('bg-white', 'w-3');
            dots[currentIndex].classList.add('bg-white/50');
          }

          currentIndex = (newIndex + images.length) % images.length;

          images[currentIndex].classList.remove('opacity-0', 'z-0');
          images[currentIndex].classList.add('opacity-100', 'z-10');

          if (dots[currentIndex]) {
            dots[currentIndex].classList.remove('bg-white/50');
            dots[currentIndex].classList.add('bg-white', 'w-3');
          }
        };

        btnPrev?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          setSlide(currentIndex - 1);
        });

        btnNext?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          setSlide(currentIndex + 1);
        });
      }

      // Control del Modal
      const modal = card.querySelector('.modal-dialog');
      const btnOpen = card.querySelector('.btn-open-modal');
      const btnClose = card.querySelector('.btn-close-modal');
      const btnWhatsapp = card.querySelector('.btn-whatsapp');

      btnWhatsapp?.addEventListener('click', (e) => {
        e.stopPropagation();
      });

      btnOpen?.addEventListener('click', () => {
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
        document.body.style.overflow = 'hidden';
      });

      const closeModal = () => {
        modal?.classList.remove('flex');
        modal?.classList.add('hidden');
        document.body.style.overflow = '';
      };

      btnClose?.addEventListener('click', closeModal);

      modal?.addEventListener('click', (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });
    });
  }

  initProductCarouselsAndModals();
</script>