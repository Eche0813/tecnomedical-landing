---
/**
 * @fileoverview Componente de tarjeta de producto individual (ProductCard) para TECNOMEDICALS S.A.S.
 * Renderiza imagen/imágenes con efecto hover, categoría, estado de stock, precio formateado en COP y botón a WhatsApp.
 */

import { SITE_CONFIG } from '../config/site';

/**
 * Propiedades aceptadas por el componente ProductCard.
 */
interface Props {
  /** Identificador único del producto */
  id: string | number;
  /** Nombre o título comercial del equipo */
  title: string;
  /** Precio en Pesos Colombianos (COP) */
  price: number;
  /** URL de la imagen principal del producto */
  image: string;
  /** Arreglo opcional con todas las URLs de imágenes cargadas */
  images?: string[];
  /** Estado de disponibilidad en inventario */
  available: boolean;
  /** Categoría del producto (ej. Oxigenoterapia Avanzada, Terapia del Sueño) */
  category?: string;
}

const { title, price, image, images = [], available, category = "Oxigenoterapia" } = Astro.props;

// Normalización de la colección de imágenes
const productImages = images.length > 0 ? images : [image];
const primaryImage = productImages[0];
const secondaryImage = productImages[1] || primaryImage;
const hasMultipleImages = productImages.length > 1;

/**
 * Formateo numérico del precio a moneda local colombiana (COP) sin decimales.
 */
const formattedPrice = new Intl.NumberFormat('es-CO', {
  style: 'currency',
  currency: 'COP',
  maximumFractionDigits: 0
}).format(price);

// Mensaje dinámico usando la constante de número de WhatsApp centralizada
const message = encodeURIComponent(`Hola Tecnomedical, estoy interesado en recibir información sobre el equipo: ${title}.`);
const whatsappUrl = `https://wa.me/${SITE_CONFIG.whatsappNumber}?text=${message}`;
---

<article class="bg-white rounded-2xl border border-slate-200/80 shadow-xs hover:border-[#0082C3]/50 hover:shadow-md transition-all duration-300 overflow-hidden flex flex-col justify-between group">
  
  <div class="p-5">
    <!-- Categoría & Indicador de Disponibilidad -->
    <div class="flex items-center justify-between mb-3">
      <span class="text-xs font-bold px-2.5 py-0.5 rounded-full bg-[#0082C3]/10 text-[#0082C3] border border-[#0082C3]/20">
        {category}
      </span>
      {available ? (
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" aria-hidden="true"></span>
          Disponible
        </span>
      ) : (
        <span class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full">
          Agotado
        </span>
      )}
    </div>

    <!-- Contenedor de Imagen con Efecto Hover y Soporte Multi-Imagen -->
    <div class="relative w-full h-48 bg-slate-50 rounded-xl mb-4 overflow-hidden flex items-center justify-center p-4 group-hover:bg-[#0082C3]/5 transition-colors duration-300">
      
      <!-- Insignia visual si el producto tiene más de 1 imagen -->
      {hasMultipleImages && (
        <span class="absolute top-2 right-2 z-10 bg-black/60 backdrop-blur-xs text-white text-[10px] font-bold px-2 py-0.5 rounded-md flex items-center gap-1 pointer-events-none select-none">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 022-2V6a2 2 0 02-2-2H6a2 2 0 02-2 2v12a2 2 0 022 2z" />
          </svg>
          {productImages.length} fotos
        </span>
      )}

      <!-- Fotografía Principal -->
      <img
        src={primaryImage}
        alt={`Fotografía del producto ${title}`}
        class={`w-full h-full object-contain transition-all duration-500 ${hasMultipleImages ? 'group-hover:opacity-0 group-hover:scale-95' : 'group-hover:scale-105'}`}
        loading="lazy"
        referrerpolicy="no-referrer"
        width="300"
        height="300"
      />

      <!-- Segunda Fotografía (se revela al pasar el mouse si existe) -->
      {hasMultipleImages && (
        <img
          src={secondaryImage}
          alt={`Segunda perspectiva del producto ${title}`}
          class="absolute inset-0 w-full h-full object-contain p-4 opacity-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          loading="lazy"
          referrerpolicy="no-referrer"
          width="300"
          height="300"
        />
      )}
    </div>

    <!-- Título comercial y Precio -->
    <h3 class="text-lg font-bold text-[#003B73] line-clamp-2 min-h-[3.5rem] leading-snug">
      {title}
    </h3>
    
    <div class="mt-2">
      <p class="text-2xl font-extrabold text-[#0082C3] tracking-tight">
        {formattedPrice}
      </p>
    </div>
  </div>

  <!-- Botón de Acción Principal -->
  <div class="p-5 pt-0">
    {available ? (
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Consultar disponibilidad de ${title} por WhatsApp`}
        class="w-full inline-flex items-center justify-center gap-2 bg-[#0082C3] hover:bg-[#003B73] text-white font-semibold py-3 px-4 rounded-xl transition-all duration-200 shadow-xs hover:shadow-md"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
        </svg>
        Consultar por WhatsApp
      </a>
    ) : (
      <button
        type="button"
        disabled
        class="w-full bg-slate-100 text-slate-400 font-medium py-3 px-4 rounded-xl cursor-not-allowed text-center"
      >
        Temporalmente Sin Stock
      </button>
    )}
  </div>
</article>